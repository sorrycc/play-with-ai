# Password for the login page. Falls back to 12306 when unset.
ADMIN_PASSWORD=12306
# ZenMux (https://zenmux.ai) key: powers every "AI model" player.
ZENMUX_API_KEY=
# TypeSafe (https://docs.typesafe.ai) key: powers the Jev player.
TYPESAFE_API_KEY=
# Hosts allowed to use the code duel besides localhost, comma-separated. It runs code on the server: leave
# empty unless the site is deployed behind ADMIN_PASSWORD on a machine you can afford to lose.
DUEL_HOSTS=
